; Engine configuration file.
; Godot 4.7.2 — Dino Kazı

config_version=5

[application]

config/name="Dino Kazı"
config/description="Çocuklar için 3B dinozor kazı ve müze oyunu. A 3D dinosaur dig and museum game for children."
config/version="1.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.8", "Mobile")
boot_splash/bg_color=Color(0.99, 0.86, 0.55, 1)
boot_splash/show_image=true
boot_splash/image="res://assets/splash.png"
config/icon="res://icon.svg"

[autoload]

Locale="*res://scripts/autoload/locale.gd"
Catalog="*res://scripts/autoload/catalog.gd"
GameState="*res://scripts/autoload/game_state.gd"
Sfx="*res://scripts/autoload/sfx.gd"
Voice="*res://scripts/autoload/voice.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/vsync/vsync_mode=1

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
environment/defaults/default_clear_color=Color(0.62, 0.82, 0.95, 1)
shading/overrides/force_lambert_over_burley=false

[gui]

theme/default_font_antialiasing=1

[internationalization]

locale/fallback="tr"
locale/locale="tr"

[input_devices]

pointing/emulate_touch_from_mouse=true
